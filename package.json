{
  "name": "startome",
  "version": "1.0.0",
  "description": "StarTome — offline-first campaign manager for Pathfinder 2e and Starfinder 2e GMs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 3003",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@vue-flow/core": "^1.48.2",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.3",
    "minisearch": "^7.2.0",
    "oh-vue-icons": "1.0.0-rc3",
    "pixi.js": "^8.22.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
